<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.trade.second_hand_trade.mapper.ProductMapper">

    <select id="selectAll" resultType="com.trade.second_hand_trade.entity.Product">
        select * from products
    </select>

    <select id="selectById" resultType="com.trade.second_hand_trade.entity.Product">
        select * from products where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO products(seller_id,title,description,price,original_price,category,`condition`,status,location,image_path,view_count,like_count,created_at,updated_at,expires_at)
        VALUES(#{sellerId},#{title},#{description},#{price},#{originalPrice},#{category},#{condition},#{status},#{location},#{imagePath},#{viewCount},#{likeCount},#{createdAt},#{updatedAt},#{expiresAt})
    </insert>

    <update id="update">
        UPDATE products
        <set>
            <if test="sellerId != null">seller_id=#{sellerId},</if>
            <if test="title != null">title=#{title},</if>
            <if test="description != null">description=#{description},</if>
            <if test="price != null">price=#{price},</if>
            <if test="originalPrice != null">original_price=#{originalPrice},</if>
            <if test="category != null">category=#{category},</if>
            <if test="condition != null">`condition`=#{condition},</if>
            <if test="status != null">status=#{status},</if>
            <if test="location != null">location=#{location},</if>
            <if test="imagePath != null">image_path=#{imagePath},</if>
            <if test="viewCount != null">view_count=#{viewCount},</if>
            <if test="likeCount != null">like_count=#{likeCount},</if>
            <if test="expiresAt != null">expires_at=#{expiresAt},</if>
            updated_at=#{updatedAt}
        </set>
        WHERE id=#{id}
    </update>

    <delete id="deleteById">
        DELETE FROM products WHERE id=#{id}
    </delete>

    <!-- 分页查询商品，支持分类、状态、关键字筛选 -->
    <select id="pageQuery" resultType="com.trade.second_hand_trade.vo.ProductVO">
        SELECT p.*, u.username as sellerName
        FROM products p
        LEFT JOIN users u ON p.seller_id = u.id
        <where>
            <if test="category != null and category != ''">
                AND p.category = #{category}
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
            <if test="keyword != null and keyword != ''">
                AND p.title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY p.created_at DESC
    </select>

    <!-- 根据卖家id分页查询 -->
    <select id="pageQueryBySellerId" resultType="com.trade.second_hand_trade.vo.ProductVO">
        SELECT p.*, u.username as sellerName
        FROM products p
        LEFT JOIN users u ON p.seller_id = u.id
        WHERE p.seller_id = #{sellerId}
        <if test="dto.status != null and dto.status != ''">
            AND p.status = #{dto.status}
        </if>
        ORDER BY p.created_at DESC
    </select>

    <!-- 更新商品状态 -->
    <update id="updateStatus">
        UPDATE products SET status = #{status}, updated_at = NOW()
        WHERE id = #{id}
    </update>


</mapper>
